/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-11-28",
	"main": "src/index.ts",
	"name": "email-explorer",
	// Served on its custom domain only (attached in the Cloudflare dashboard): no *.workers.dev
	// address and no per-version preview addresses, which would be second front doors to the mail.
	"workers_dev": false,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"compatibility_flags": ["nodejs_compat", "enable_email_sending_queuing"],
	"assets": {
		"directory": "dashboard",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/docs", "/openapi.json", "/robots.txt"]
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "email-explorer","preview_bucket_name": "email-explorer"
		}
	],
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	// Ceiling per client IP on the credential endpoints (login, register, forgot/reset/change
	// password), on top of the per-account backoff. The namespace id is any number unique in the
	// Cloudflare account.
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"triggers": {
		"crons": ["15 */3 * * *"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MailboxDO"]
		}
	]
}
